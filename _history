ib(value - 1) + fib(value - 2);\n    }\n\n\n\n    /**\n     * make enemy patrol back and forth.\n     */\n    //% block=\"make $enemy=variables_get(mySprite) patrol with $speed\"\n    //% speed.defl=30\n    export function makeEnemyPatrol(enemy: Sprite, speed: number) {\n        enemy.setVelocity(speed, 0)\n        game.onUpdate(function () {\n            if (enemy.isHittingTile(CollisionDirection.Left)) {\n                enemy.vx = speed\n            }\n            if (enemy.isHittingTile(CollisionDirection.Right)) {\n                enemy.vx = -speed\n            }\n        })\n    }\n\n    /**\n     * Gives a sprite gravity\n     */\n    //% block=\"give $sprite=variables_get(mySprite) gravity\"\n    export function giveGravity(sprite: Sprite) {\n        sprite.ay = 200\n    }\n\n    \n\n    /**\n     * spawn enemie on tile.\n     */\n    //% block=\"create sprite %img=screen_image_picker of kind %kind=spritekind\"\n    //% kind.defl=Player\n    export function createCustomSprite(img: Image, kind: number): Sprite {\n        let newSprite = sprites.create(img, kind);\n        return newSprite;\n    }\n}\n\n//for (let value of tiles.getTilesByType(assets.tile`myTile0`)) {\n//    tiles.placeOnTile(mySprite2, value)\n//    GameKit.makeEnemyPatrol(mySprite2, 30)\n//    GameKit.giveGravity(mySprite2)\n//}","tilemap.g.jres":"{\n    \"transparency16\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true\n    },\n    \"tile1\": {\n        \"data\": \"hwQQABAAAAD//////////5+ZZpZpZpn5n2ZmZmZmZvmfZmZmZmZm+W9mZmZmZmb2b2ZmZmZmZvZvZmZmZmZm9p9mZmZmZmb5n2ZmZmZmZvlvZmZmZmZm9m9mZmZmZmb2b2ZmZmZmZvafZmZmZmZm+Z9mZmZmZmb5n5lmlmlmmfn//////////w==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true,\n        \"displayName\": \"myTi